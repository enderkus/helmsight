# systemd unit for helmsight.
#
#   useradd --system --home-dir /var/lib/helmsight --shell /usr/sbin/nologin helmsight
#   install -m 0755 helmsight /usr/local/bin/helmsight
#   install -d -m 0750 -o root -g helmsight /etc/helmsight
#   install -m 0640 -o root -g helmsight helmsight.toml /etc/helmsight/
#   install -m 0640 -o root -g helmsight id_ed25519 /etc/helmsight/
#   cp helmsight.service /etc/systemd/system/ && systemctl enable --now helmsight

[Unit]
Description=helmsight agentless server monitoring
Documentation=https://enderkus.github.io/helmsight/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helmsight
Group=helmsight
ExecStart=/usr/local/bin/helmsight serve --config /etc/helmsight/helmsight.toml --log-format json
Restart=on-failure
RestartSec=5s

StateDirectory=helmsight
StateDirectoryMode=0700
ConfigurationDirectory=helmsight
Environment=HELMSIGHT_LOG=info

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
